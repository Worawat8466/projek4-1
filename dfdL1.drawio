<mxfile host="app.diagrams.net">
  <diagram name="หน้า-1" id="b4oMw75COoOa4HcnnkWn">
    <mxGraphModel dx="2570" dy="1372" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ---------------- ENTITIES ----------------\n    E_Cust[\&quot;ลูกค้า / เจ้าของสัตว์เลี้ยง&lt;br/&gt;(Customer / Pet Owner)\&quot;]\n    E_Staff[\&quot;สัตวแพทย์ / บุคลากรประจำคลินิก&lt;br/&gt;(Veterinarian &amp; Staff)\&quot;]\n    E_Supp[\&quot;บริษัทผู้จัดจำหน่าย&lt;br/&gt;(Suppliers / Vendors)\&quot;]\n\n    %% ---------------- PROCESSES ----------------\n    P1[\&quot;1.0 จัดการสิทธิ์ เข้าสู่ระบบ และตั้งค่าร้าน\&quot;]\n    P2[\&quot;2.0 จัดการทะเบียนลูกค้าและสัตว์เลี้ยง\&quot;]\n    P3[\&quot;3.0 จัดการข้อมูลสินค้าและอัตราแปลงหน่วย\&quot;]\n    P4[\&quot;4.0 จัดซื้อสินค้าและตรวจรับแปลงหน่วยเข้าคลัง\&quot;]\n    P5[\&quot;5.0 คิดเงินหน้าร้าน ตัดสต็อก FEFO และพิมพ์สลิป\&quot;]\n    P6[\&quot;6.0 ประมวลผลและสรุปรายงานยอดขาย\&quot;]\n\n    %% ---------------- DATA STORES ----------------\n    D6[(\&quot;D6: ข้อมูลระบบและสิทธิ์ Staff\&quot;)]\n    D1[(\&quot;D1: ข้อมูลลูกค้าและสัตว์เลี้ยง\&quot;)]\n    D2[(\&quot;D2: แคตตาล็อกสินค้าและบริการ\&quot;)]\n    D4[(\&quot;D4: ข้อมูลคู่ค้าและใบสั่งซื้อ PO\&quot;)]\n    D3[(\&quot;D3: คลังสินค้ารายล็อตและ FEFO\&quot;)]\n    D5[(\&quot;D5: สมุดบันทึกรายการขาย Sales Ledger\&quot;)]\n\n    %% ---------------- DATA FLOWS: TIER 1 ----------------\n    E_Staff --&gt;|\&quot;ตั้งค่าเครื่อง, รหัสผ่าน, PIN\&quot;| P1\n    P1 &lt;--&gt;|\&quot;บันทึก Master Hash &amp; Recovery Key\&quot;| D6\n\n    E_Cust --&gt;|\&quot;ข้อมูลติดต่อ, ประวัติสัตว์เลี้ยง\&quot;| P2\n    E_Staff --&gt;|\&quot;ค้นหา / อัปเดตเวชระเบียน\&quot;| P2\n    P2 &lt;--&gt;|\&quot;บันทึกประวัติเจ้าของและสัตว์\&quot;| D1\n\n    E_Staff --&gt;|\&quot;รายการยา, ราคาขาย, อัตราแปลง 1=24\&quot;| P3\n    P3 &lt;--&gt;|\&quot;บันทึกแคตตาล็อกสินค้า\&quot;| D2\n\n    %% ---------------- DATA FLOWS: TIER 2 (PURCHASING) ----------------\n    E_Staff --&gt;|\&quot;เปิดใบสั่งซื้อ PO\&quot;| P4\n    P4 --&gt;|\&quot;ใบสั่งซื้อ PO\&quot;| E_Supp\n    E_Supp --&gt;|\&quot;ส่งมอบสินค้า + ข้อมูล Lot/EXP\&quot;| P4\n    P4 &lt;--&gt;|\&quot;อัปเดตสถานะ PO (รับสินค้าแล้ว)\&quot;| D4\n    D2 -.-&gt;|\&quot;ดึงอัตราแปลงหน่วย (เช่น 1=24)\&quot;| P4\n    P4 --&gt;|\&quot;แตกหน่วยย่อย -&gt; บันทึกล็อตใหม่\&quot;| D3\n\n    %% ---------------- DATA FLOWS: TIER 3 (POS &amp; FEFO) ----------------\n    E_Staff --&gt;|\&quot;เลือกสัตว์เลี้ยง, ยิงบาร์โค้ด, สั่งยา\&quot;| P5\n    E_Cust --&gt;|\&quot;ชำระเงิน (Cash / QR PromptPay)\&quot;| P5\n    D1 -.-&gt;|\&quot;ดึงข้อมูลสัตว์เลี้ยงประจำตัว\&quot;| P5\n    D2 -.-&gt;|\&quot;ดึงราคาขาย / ค่าบริการ\&quot;| P5\n    D3 &lt;--&gt;|\&quot;คำนวณตัดสต็อกยาล็อต EXP ใกล้สุด (FEFO)\&quot;| P5\n    P5 --&gt;|\&quot;พิมพ์สลิปใบเสร็จ 80mm &amp; ฉลากยา\&quot;| E_Cust\n    P5 --&gt;|\&quot;บันทึกรายการขาย, COGS, กำไรขั้นต้น\&quot;| D5\n\n    %% ---------------- DATA FLOWS: TIER 4 (ANALYTICS) ----------------\n    D5 --&gt;|\&quot;ประวัติยอดขายและต้นทุนจริง\&quot;| P6\n    D3 -.-&gt;|\&quot;สถานะสต็อกและวันหมดอายุ\&quot;| P6\n    P6 --&gt;|\&quot;แดชบอร์ด KPI, สรุปยอดสุทธิ, COGS, Top 10\&quot;| E_Staff&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pbr8rL8_rgWr_zQ5xGMm-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
